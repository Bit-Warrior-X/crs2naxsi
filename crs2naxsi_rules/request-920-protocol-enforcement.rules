# Auto-converted from CRS REQUEST-920-PROTOCOL-ENFORCEMENT.conf by crs2naxsi.py
# Review before production use. NAXSI whitelists: wl:<crs_id>

MainRule "rx:\\b(?:keep-alive|close),\\s?(?:keep-alive|close)\\b" "msg:CRS 920210 Multiple/Conflicting Connection Header Data Found" "mz:$HEADERS_VAR:connection" "s:$PROTOCOL:2" id:920210;
MainRule "rx:(?i)%uff[0-9a-f]{2}" "msg:CRS 920260 Unicode Full/Half Width Abuse Attack Attempt" "mz:URL|ARGS|BODY" "s:$PROTOCOL:2" id:920260;
MainRule "rx:^$" "msg:CRS 920290 Empty Host Header" "mz:$HEADERS_VAR:host" "s:$PROTOCOL:8" id:920290;
MainRule "rx:^$" "msg:CRS 920330 Empty User Agent Header" "mz:$HEADERS_VAR:user-agent" "s:$PROTOCOL:1" id:920330;
MainRule "rx:(?:^([\\d.]+|\\[[\\da-f:]+\\]|[\\da-f:]+)(:[\\d]+)?$)" "msg:CRS 920350 Host header is a numeric IP address" "mz:$HEADERS_VAR:host" "s:$PROTOCOL:2" id:920350;
MainRule "rx:charset.*?charset" "msg:CRS 920530 Multiple charsets detected in content type header" "mz:$HEADERS_VAR:content-type" "s:$PROTOCOL:8" id:920530;
MainRule "rx:\\.[^.~]+~(?:/.*|)$" "msg:CRS 920500 Attempt to access a backup or working file" "mz:URL" "s:$PROTOCOL:8" id:920500;
MainRule "rx:(?i)\\x5cu[0-9a-f]{4}" "msg:CRS 920540 (names)" "mz:ARGS|NAME|BODY|NAME" "s:$PROTOCOL:8" id:1420540;
MainRule "rx:(?i)\\x5cu[0-9a-f]{4}" "msg:CRS 920540 Possible Unicode character bypass detected" "mz:URL|ARGS|HEADERS|BODY" "s:$PROTOCOL:8" id:920540;
MainRule "str:#" "msg:CRS 920610 Raw (unencoded) fragment in request URI" "mz:URL|ARGS" "s:$PROTOCOL:8" id:920610;
MainRule "rx:%[0-9a-fA-F]{2}" "msg:CRS 920230 Multiple URL Encoding Detected" "mz:ARGS|BODY" "s:$PROTOCOL:2" id:920230;
MainRule "rx:(?:^|[^\\x5c])\\x5c[cdeghijklmpqwxyz123456789]" "msg:CRS 920460 (names) [LOST t:htmlentitydecode]" "mz:ARGS|NAME|BODY|NAME" "s:$PROTOCOL:8" id:1420460;
MainRule "rx:(?:^|[^\\x5c])\\x5c[cdeghijklmpqwxyz123456789]" "msg:CRS 920460 Abnormal character escapes in request [LOST t:htmlentitydecode]" "mz:URL|ARGS|HEADERS|BODY" "s:$PROTOCOL:8" id:920460;
