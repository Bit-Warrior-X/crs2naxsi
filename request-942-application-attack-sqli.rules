MainRule "rx:\\W{4}" "msg:CRS 942460 Meta-Character Anomaly Detection Alert - Repetitive Non-Word Characters [PL3]" "mz:ARGS|BODY" "s:$SQL:2" id:942460;
MainRule "rx:\\x27(?:[\\s\\x0b\\(\\)\\+\\-0-9<=@-Z_a-\\{\\}]{2,29}|(?:[\\+/-9A-Za-z]{4})+(?:(?:[\\+/-9A-Za-z]{2}=|[\\+/-9A-Za-z]{3})=)?)\\x27" "msg:CRS 942511 SQLi bypass attempt by ticks detected [PL3]" "mz:$HEADERS_VAR:Cookie|ARGS|BODY" "s:$SQL:8" id:942511;
MainRule "rx:\\x27(?:[\\s\\x0b\\(\\)\\+\\-0-9<=@-Z_a-\\{\\}]{2,29}|(?:[\\+/-9A-Za-z]{4})+(?:(?:[\\+/-9A-Za-z]{2}=|[\\+/-9A-Za-z]{3})=)?)\\x27" "msg:CRS 942511 (names) SQLi bypass attempt by ticks detected [PL3]" "mz:ARGS|BODY|NAME" "s:$SQL:8" id:1442511;
